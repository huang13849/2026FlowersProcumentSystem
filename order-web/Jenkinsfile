// \u2500\u2500 order-web pipeline (\u524d\u7aef\u72ec\u7acb\u5fae\u670d\u52a1) \u2500\u2500
//   * \u590d\u7528 k3s-build agent (xspt05 + dind sidecar, \u5df2\u5728 k3s \u4e0a)
//   * SCM: Gitea (100.76.15.64:13000, credentialId=gitea-token)
//   * \u7528 in-cluster SA jenkins-agent (clusterwide deploy perms)
//
//   order-web \u90e8\u7f72\u5728 xsyysj \u8282\u70b9, \u540c\u6e90 /api/* \u53cd\u4ee3\u5230 order-service:3008
//   NodePort 31020

pipeline {
  agent { label 'k3s-build' }

  options {
    timeout(time: 15, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    REGISTRY    = '100.76.15.64:5001'
    IMAGE_NS    = 'supply-chain'
    IMAGE_NAME  = 'order-web'
    K8S_NS      = 'supply-chain'
    NODE_PORT   = '31020'
    SERVICE_HOST = '100.96.54.109'
  }

  stages {
    stage('Checkout (Gitea)') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'http://100.76.15.64:13000/admin/supply-chain-platform.git',
            credentialsId: 'gitea-token',
          ]],
          extensions: [[$class: 'CloneOption', shallow: true, depth: 1, noTags: false]],
        ])
        sh 'git rev-parse HEAD && git log --oneline -3'
      }
    }

    stage('Build & Push Image') {
      steps {
        sh '''
          set -euo pipefail
          SHA=$(git rev-parse --short=8 HEAD)
          TAG="${IMAGE_NAME}-${SHA}-${BUILD_NUMBER}"
          IMG="${REGISTRY}/${IMAGE_NS}/${IMAGE_NAME}:${TAG}"
          echo "[1/3] build $IMG"
          docker build --platform linux/amd64 -t "$IMG" ./${IMAGE_NAME} | tail -30
          echo "[2/3] push $IMG"
          docker push "$IMG"
          echo "[3/3] image info"
          printf '%s' "$TAG" > .image-tag
          printf '%s' "$IMG" > .image-url
          cat .image-url
        '''
      }
    }

    stage('Deploy to k3s') {
      steps {
        sh '''
          set -euo pipefail
          IMG=$(cat .image-url)
          TAG=$(cat .image-tag)
          echo "[1/4] set image deploy/${IMAGE_NAME} -> $IMG"
          kubectl -n ${K8S_NS} set image deploy/${IMAGE_NAME} ${IMAGE_NAME}="$IMG"
          echo "[2/4] rollout status"
          kubectl -n ${K8S_NS} rollout status deploy/${IMAGE_NAME} --timeout=180s
          echo "[3/4] final container image"
          kubectl -n ${K8S_NS} get deploy ${IMAGE_NAME} -o jsonpath='{.spec.template.spec.containers[0].image}'
          printf '\\n'
          echo "[4/4] pod node + ready"
          kubectl -n ${K8S_NS} get pod -l app=${IMAGE_NAME} -o wide
        '''
      }
    }

    stage('Smoke Test') {
      steps {
        sh '''
          set -euo pipefail
          sleep 5
          echo "[1/4] healthz"
          code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "http://${SERVICE_HOST}:${NODE_PORT}/healthz" || echo ERR)
          echo "$code /healthz"
          [ "$code" = "200" ] || exit 30

          echo "[2/4] UI html"
          html=$(curl -s --max-time 20 "http://${SERVICE_HOST}:${NODE_PORT}/")
          echo "$html" | grep -q '<title>\u8ba2\u5355\u7ba1\u7406</title>' || { echo "missing title"; exit 31; }
          echo "[ok] title \u8ba2\u5355\u7ba1\u7406 present"

          echo "[3/4] static assets"
          for u in /favicon.svg /index.html; do
            code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://${SERVICE_HOST}:${NODE_PORT}${u}" || echo ERR)
            echo "$code $u"
            [ "$code" = "200" ] || exit 32
          done

          echo "[4/4] backend API via /api/orders (nginx \u53cd\u4ee3)"
          code=$(curl -s -o /tmp/ow_body -w '%{http_code}' --max-time 30 "http://${SERVICE_HOST}:${NODE_PORT}/api/orders?limit=1" || echo ERR)
          echo "$code /api/orders"
          [ "$code" = "200" ] || exit 33
          head -c 100 /tmp/ow_body; echo

          echo "smoke OK"
        '''
      }
    }
  }

  post {
    success { echo 'order-web pipeline SUCCEEDED' }
    failure { echo 'order-web pipeline FAILED' }
  }
}
