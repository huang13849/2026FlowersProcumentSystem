pipeline {
  agent { label 'k3s-build' }

  environment {
    REGISTRY = '100.76.15.64:5001'
    IMAGE_NAME = 'supply-chain/identity-service'
    IMAGE_TAG = "identity-${BUILD_NUMBER}-${GIT_COMMIT?.take(7)}"
  }

  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build and Push') {
      steps {
        sh '''
          set -euo pipefail
          cd identity-service
          docker build -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} .
          docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
          docker tag ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:latest
          docker push ${REGISTRY}/${IMAGE_NAME}:latest
        '''
      }
    }
    stage('Deploy') {
      steps {
        sh '''
          set -euo pipefail
          set +x
          K8S_TOKEN=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
          K8S_SERVER=https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT_HTTPS}
          K8S_CA=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
          kctl() { kubectl --server="${K8S_SERVER}" --token="${K8S_TOKEN}" --certificate-authority="${K8S_CA}" "$@"; }
          kctl -n supply-chain set image deployment/identity-service identity-service=${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
          kctl -n supply-chain rollout status deployment/identity-service --timeout=240s
          kctl -n supply-chain get deployment identity-service -o jsonpath='{.spec.template.spec.containers[0].image}'
        '''
      }
    }
  }
}
