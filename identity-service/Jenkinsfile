pipeline {
  agent { label 'k3s-build' }

  environment {
    REGISTRY = '100.76.15.64:5001'
    IMAGE_NAME = 'supply-chain/identity-service'
    IMAGE_TAG = "identity-${BUILD_NUMBER}-${GIT_COMMIT?.take(7)}"
    K3S_HOST = 'huangfra-ubun-master@100.96.54.109'
  }

  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build and Push') {
      steps {
        sh '''
          set -euo pipefail
          cd identity-service
          docker build -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} .
          docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
          docker tag ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:latest
          docker push ${REGISTRY}/${IMAGE_NAME}:latest
        '''
      }
    }
    stage('Deploy') {
      steps {
        sh '''
          set -euo pipefail
          SSH_KEY=/var/jenkins_home/.ssh/id_ed25519
          ssh -i ${SSH_KEY} -o BatchMode=yes -o StrictHostKeyChecking=no ${K3S_HOST} bash -s <<REMOTE
            set -euo pipefail
            export KUBECONFIG=\$HOME/k3s.yaml
            cd /home/huangfra-ubun-master/supply-chain-platform
            git fetch origin main
            git reset --hard origin/main
            sed -i "s|image: .*supply-chain/identity-service:.*|image: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}|" identity-service/k8s/deployment.yaml
            kubectl apply --server-side=true -f identity-service/k8s/deployment.yaml
            kubectl -n supply-chain rollout status deployment/identity-service --timeout=240s
            kubectl -n supply-chain get deploy identity-service -o jsonpath='{.spec.template.spec.containers[0].image}'
REMOTE
        '''
      }
    }
  }
}
