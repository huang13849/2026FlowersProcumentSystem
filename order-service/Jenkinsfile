// ── order-service pipeline (后端独立微服务, 纯 API) ──
//   * 复用 k3s-build agent (xspt05 + dind sidecar, 已在 k3s 上)
//   * SCM: Gitea (100.76.15.64:13000, credentialId=gitea-token)
//   * 用 in-cluster SA jenkins-agent (clusterwide deploy perms)
//
//   order-service 现在只服务 backend API (Node.js + Express + PG)
//   前端 UI 已拆到 order-web (nginx 静态服务, /api/* 反代到本服务)
//   NodePort 31008 → order-service
//
// 注: 走 in-cluster 所以不需要 office-k3s-kubeconfig

pipeline {
  agent { label 'k3s-build' }

  options {
    timeout(time: 25, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    REGISTRY    = '100.76.15.64:5001'
    IMAGE_NS    = 'supply-chain'
    IMAGE_NAME  = 'order-service'
    K8S_NS      = 'supply-chain'
    NODE_PORT   = '31008'
    SERVICE_HOST = '100.96.54.109'
  }

  stages {
    stage('Checkout (Gitea)') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'http://100.76.15.64:13000/admin/supply-chain-platform.git',
            credentialsId: 'gitea-token',
          ]],
          extensions: [[$class: 'CloneOption', shallow: true, depth: 1, noTags: false]],
        ])
        sh 'git rev-parse HEAD && git log --oneline -3'
      }
    }

    stage('Build & Push Image') {
      steps {
        sh '''
          set -euo pipefail
          SHA=$(git rev-parse --short=8 HEAD)
          TAG="${IMAGE_NAME}-${SHA}-${BUILD_NUMBER}"
          IMG="${REGISTRY}/${IMAGE_NS}/${IMAGE_NAME}:${TAG}"
          echo "[1/3] build $IMG"
          docker pull --platform linux/amd64 100.76.15.64:5001/library/node:20-alpine-amd64 | tail -3
          DOCKER_BUILDKIT=1 docker build --platform linux/amd64 -t "$IMG" ./${IMAGE_NAME} | tail -30
          echo "[2/3] push $IMG"
          docker push "$IMG"
          echo "[3/3] image info"
          printf '%s' "$TAG" > .image-tag
          printf '%s' "$IMG" > .image-url
          cat .image-url
        '''
      }
    }

    stage('Deploy to k3s') {
      steps {
        sh '''
          set -euo pipefail
          IMG=$(cat .image-url)
          TAG=$(cat .image-tag)
          echo "[1/4] set image deploy/${IMAGE_NAME} -> $IMG"
          kubectl -n ${K8S_NS} set image deploy/${IMAGE_NAME} ${IMAGE_NAME}="$IMG"
          echo "[2/4] rollout status"
          kubectl -n ${K8S_NS} rollout status deploy/${IMAGE_NAME} --timeout=240s
          echo "[3/4] final container image"
          kubectl -n ${K8S_NS} get deploy ${IMAGE_NAME} -o jsonpath='{.spec.template.spec.containers[0].image}'
          printf '\\n'
          echo "[4/4] pod node + ready"
          kubectl -n ${K8S_NS} get pod -l app=${IMAGE_NAME} -o wide
        '''
      }
    }

    stage('Smoke Test (API)') {
      steps {
        sh '''
          set -euo pipefail
          sleep 5
          echo "[1/3] /api/health"
          code=$(curl -s -o /tmp/ord_body -w '%{http_code}' --max-time 20 "http://${SERVICE_HOST}:${NODE_PORT}/api/health" || echo ERR)
          echo "$code /api/health"
          [ "$code" = "200" ] || exit 30

          echo "[2/3] /api/orders?limit=1"
          code=$(curl -s -o /tmp/ord_body -w '%{http_code}' --max-time 30 "http://${SERVICE_HOST}:${NODE_PORT}/api/orders?limit=1" || echo ERR)
          echo "$code /api/orders"
          [ "$code" = "200" ] || exit 31
          head -c 100 /tmp/ord_body; echo

          echo "[3/3] clusterIP direct"
          IP=$(kubectl -n ${K8S_NS} get svc ${IMAGE_NAME} -o jsonpath='{.spec.clusterIP}' 2>/dev/null || echo '')
          if [ -n "$IP" ]; then
            code=$(curl -s -m 10 -o /dev/null -w '%{http_code}' "http://${IP}:3008/api/health" || echo ERR)
            echo "$code clusterIP direct"
          fi
          echo "smoke OK"
        '''
      }
    }
  }

  post {
    success { echo 'order-service pipeline SUCCEEDED' }
    failure { echo 'order-service pipeline FAILED' }
  }
}