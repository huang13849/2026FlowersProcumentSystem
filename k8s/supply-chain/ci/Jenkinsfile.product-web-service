// ── product-web-service pipeline ──
//   * 复用常驻 Jenkins agent: k3s-build-agent
//   * SCM: Gitea (100.76.15.64:13000)
//   * Build: product-service/Dockerfile.web -> product-web-service
//   * Deploy: product-web-service NodePort 31001

pipeline {
  agent { label 'k3s-build' }

  options {
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    REGISTRY  = '100.76.15.64:5001'
    NAMESPACE = 'supply-chain'
    SERVICE  = 'product-web-service'
    CONTAINER = 'product-web-service'
  }

  stages {
    stage('Checkout (Gitea)') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'http://100.76.15.64:13000/admin/supply-chain-platform.git',
            credentialsId: 'gitea-token',
          ]],
          extensions: [[$class: 'CloneOption', shallow: true, depth: 1, noTags: false]],
        ])
        sh 'git rev-parse HEAD && git log --oneline -3'
      }
    }

    stage('Build & Push Image') {
      steps {
        sh '''
          set -euo pipefail
          TAG="${SERVICE}-${BUILD_NUMBER}-$(date +%Y%m%d%H%M%S)"
          IMG="${REGISTRY}/supply-chain/${SERVICE}:${TAG}"
          echo "[1/3] build $IMG"
          docker build --pull --no-cache --platform linux/amd64 -f ./product-service/Dockerfile.web -t "$IMG" ./product-service | tail -30
          echo "[2/3] push $IMG"
          docker push "$IMG"
          echo "[3/3] image info"
          printf '%s' "$TAG" > .image-tag
          printf '%s' "$IMG" > .image-url
          cat .image-tag; cat .image-url
        '''
      }
    }

    stage('Deploy to k3s') {
      steps {
        sh '''
          set -euo pipefail
          IMG=$(cat .image-url)
          echo "[1/2] set image deploy/${SERVICE} -> $IMG"
          kubectl -n ${NAMESPACE} set image deploy/${SERVICE} ${CONTAINER}="$IMG"
          echo "[2/2] rollout status"
          kubectl -n ${NAMESPACE} rollout status deploy/${SERVICE} --timeout=180s
        '''
      }
    }

    stage('Smoke Test (31001)') {
      steps {
        sh '''
          set -euo pipefail
          sleep 3
          for u in \
            http://100.96.54.109:31001/ \
            http://100.96.54.109:31001/api/health \
            http://100.96.54.109:31001/api/products?limit=1 \
            http://100.96.54.109:31001/api/product-submissions?status=pending; do
            code=$(curl -s -o /tmp/jenkins_product_web_body -w '%{http_code}' --max-time 20 "$u" || echo ERR)
            echo "$code $u"
            [ "$code" = "200" ] || exit 30
          done
          html=$(curl -s --max-time 20 http://100.96.54.109:31001/)
          echo "$html" | grep -q '<title>商品管理系统</title>' || { echo "missing title"; exit 31; }
          echo "smoke OK"
        '''
      }
    }
  }

  post {
    success { echo 'product-web-service pipeline SUCCEEDED' }
    failure { echo 'product-web-service pipeline FAILED' }
  }
}
