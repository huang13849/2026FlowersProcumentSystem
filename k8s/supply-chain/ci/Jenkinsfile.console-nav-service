// ── console-nav-service pipeline ──
//   * Reuse Jenkins agent label: k3s-build
//   * SCM: Gitea (100.76.15.64:13000)
//   * Build: docker build/push via DOCKER_HOST=tcp://localhost:2375
//   * Deploy: in-cluster kubectl
//   * Smoke: NodePort 31040

pipeline {
  agent { label 'k3s-build' }

  options {
    timeout(time: 15, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    REGISTRY  = '100.76.15.64:5001'
    NAMESPACE = 'supply-chain'
    SERVICE  = 'console-nav-service'
  }

  stages {
    stage('Checkout (Gitea)') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[
            url: 'http://100.76.15.64:13000/admin/supply-chain-platform.git',
            credentialsId: 'gitea-token',
          ]],
          extensions: [[$class: 'CloneOption', shallow: true, depth: 1, noTags: false]],
        ])
        sh 'git rev-parse HEAD && git log --oneline -3'
      }
    }

    stage('Build & Push Image') {
      steps {
        sh '''
          set -euo pipefail
          TAG="${SERVICE}-${BUILD_NUMBER}-$(date +%Y%m%d%H%M%S)"
          IMG="${REGISTRY}/supply-chain/${SERVICE}:${TAG}"
          echo "[1/3] build $IMG"
          docker build --pull --no-cache --platform linux/amd64 -t "$IMG" ./${SERVICE} | tail -30
          echo "[2/3] push $IMG"
          docker push "$IMG"
          echo "[3/3] image info"
          printf '%s' "$TAG" > .image-tag
          printf '%s' "$IMG" > .image-url
          cat .image-tag; cat .image-url
        '''
      }
    }

    stage('Deploy to k3s') {
      steps {
        sh '''
          set -euo pipefail
          IMG=$(cat .image-url)
          echo "[0/2] sync nav-js-hotfix ConfigMap"
          kubectl -n ${NAMESPACE} create configmap nav-js-hotfix \
            --from-file=server.js=./console-nav-service/server.js \
            --from-file=nav.js=./console-nav-service/public/nav.js \
            --from-file=nav.css=./console-nav-service/public/nav.css \
            --dry-run=client -o yaml | kubectl apply -f -
          echo "[1/2] set image deploy/${SERVICE} -> $IMG"
          kubectl -n ${NAMESPACE} set image deploy/${SERVICE} web="$IMG"
          echo "[2/2] rollout status"
          kubectl -n ${NAMESPACE} rollout status deploy/${SERVICE} --timeout=180s
        '''
      }
    }

    stage('Smoke Test (31040)') {
      steps {
        sh '''
          set -euo pipefail
          sleep 3
          for u in \
            http://100.96.54.109:31040/healthz \
            http://100.96.54.109:31040/nav.js; do
            code=$(curl -s -o /tmp/jenkins_console_nav_body -w '%{http_code}' --max-time 20 "$u" || echo ERR)
            echo "$code $u"
            [ "$code" = "200" ] || exit 30
          done
          code=$(curl -s -o /tmp/jenkins_console_nav_apps -w '%{http_code}' --max-time 20 http://100.96.54.109:31040/api/nav/apps || echo ERR)
          echo "$code http://100.96.54.109:31040/api/nav/apps"
          [ "$code" = "200" ] || exit 30
          if grep -q '新增商品审核' /tmp/jenkins_console_nav_apps; then
            echo "submission review should live under product management, not console navbar"
            exit 31
          fi
          echo "smoke OK"
        '''
      }
    }
  }

  post {
    success { echo 'console-nav-service pipeline SUCCEEDED' }
    failure { echo 'console-nav-service pipeline FAILED' }
  }
}
